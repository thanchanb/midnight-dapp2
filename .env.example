# Midnight ShadowVault Environment Configuration Template
# Copy this file to .env and supply your authentic credentials.
# DO NOT commit .env to version control.

# Target Network (Must be one of: TestNet, DevNet, preview, preprod)
MIDNIGHT_NETWORK=TestNet

# Consensus Node RPC Endpoint
MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network

# Midnight GraphQL Indexer URLs
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Proof Server Endpoint (Local Actix Prover port 6300 or remote proof server)
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# LevelDB Client State Encryption Password (Minimum 16 characters, >= 3 character classes)
MIDNIGHT_STORAGE_PASSWORD=

# Live Deployment & E2E Wallet Credentials (Required for on-chain submission)
# 64-character hexadecimal public keys from funded Lace / devnet wallet
MIDNIGHT_WALLET_COIN_PUBLIC_KEY=
MIDNIGHT_WALLET_ENCRYPTION_PUBLIC_KEY=

# Optional: Wallet Balancing Service URL (if not balancing via browser connector)
MIDNIGHT_BALANCING_URL=
