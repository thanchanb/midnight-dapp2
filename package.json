{
  "name": "midnight-shadow-vault",
  "version": "1.0.0",
  "description": "ShadowVault: Privacy-Preserving Shielded Escrow & Secret Verification System on Midnight Blockchain",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "preview": "vite preview",
    "compile": "compact compile contracts/shadow_vault.compact managed",
    "build": "tsc",
    "test": "vitest run && python3 scripts/scan_secrets.py",
    "test:circuit": "vitest run test/circuit.test.ts",
    "test:frontend": "vitest run test/frontend.test.ts",
    "test:sim": "vitest run test/auction.sim.test.ts",
    "test:e2e": "npx tsx test/e2e_live.test.ts",
    "coverage": "vitest run --coverage",
    "scan:secrets": "python3 scripts/scan_secrets.py",
    "evidence": "npx tsx scripts/write_evidence.ts",
    "deploy": "npx tsx scripts/deploy.ts"
  },
  "keywords": [
    "midnight",
    "compact",
    "zero-knowledge",
    "privacy",
    "blockchain",
    "smart-contracts"
  ],
  "author": "Midnight Developer",
  "license": "Apache-2.0",
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-dapp-connector-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "^4.1.1",
    "@midnight-ntwrk/wallet": "^5.0.0",
    "@midnight-ntwrk/wallet-sdk": "^1.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^4.1.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^4.0.1",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^3.1.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.9"
  }
}
